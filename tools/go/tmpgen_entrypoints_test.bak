package bundler

// 第 116 轮 Go 探针：scanner.addEntryPoints —— 真 1:1（mock FS 注入 + 真实 resolver/parse）。
// 覆盖：相对/绝对/包路径输入、显式 outputPath、自动 outputPath 生成+扩展剥离、outbase 计算、
// stdin 入口、sourceIndex 去重。dump []graph.EntryPoint 规范结构。
import (
	"encoding/json"
	"strings"
	"os"
	"testing"

	"github.com/evanw/esbuild/internal/ast"
	"github.com/evanw/esbuild/internal/cache"
	"github.com/evanw/esbuild/internal/config"
	"github.com/evanw/esbuild/internal/fs"
	"github.com/evanw/esbuild/internal/helpers"
	"github.com/evanw/esbuild/internal/logger"
	"github.com/evanw/esbuild/internal/graph"
	"github.com/evanw/esbuild/internal/resolver"
)


// addEntryPointsCore116 mirrors the deterministic phase-2 of scanner.addEntryPoints verbatim
// (from "Determine output paths" to return), with resolve results + parse indices injected.
func addEntryPointsCore116(s *scanner, entryPoints []EntryPoint,
	infos [][]resolver.ResolveResult, parse func(resolver.ResolveResult) uint32) []graph.EntryPoint {
	entryMetas := make([]graph.EntryPoint, 0, len(entryPoints)+1)
	entryPointAbsResolveDir := s.fs.Cwd()
	type toParseT struct{ index int; rr resolver.ResolveResult }
	var toParse []toParseT
	for i, results := range infos {
		if results == nil { continue }
		for _, rr := range results {
			prettyPaths := resolver.MakePrettyPaths(s.fs, rr.PathPair.Primary)
			outputPath := entryPoints[i].OutputPath
			auto := false
			if outputPath == "" {
				outputPath = entryPoints[i].InputPath
				windowsVolumeLabel := ""
				if s.fs.IsAbs(outputPath) && len(outputPath) >= 3 && outputPath[1] == ':' {
					c := outputPath[0]
					if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') {
						if outputPath[2] == '/' || outputPath[2] == '\\' {
							windowsVolumeLabel = outputPath[:3]
							outputPath = outputPath[3:]
						}
					}
				}
				outputPath = sanitizeFilePathForVirtualModulePath(outputPath)
				if windowsVolumeLabel != "" { outputPath = windowsVolumeLabel + outputPath }
				auto = true
			}
			toParse = append(toParse, toParseT{len(entryMetas), rr})
			entryMetas = append(entryMetas, graph.EntryPoint{OutputPath: outputPath, SourceIndex: 0, OutputPathWasAutoGenerated: auto})
			_ = prettyPaths
		}
	}
	for i := range entryMetas {
		ep := &entryMetas[i]
		if ep.OutputPathWasAutoGenerated && !s.fs.IsAbs(ep.OutputPath) {
			ep.OutputPath = s.fs.Join(entryPointAbsResolveDir, ep.OutputPath)
		}
	}
	if s.options.AbsOutputBase == "" {
		s.options.AbsOutputBase = lowestCommonAncestorDirectory(s.fs, entryMetas)
		if s.options.AbsOutputBase == "" { s.options.AbsOutputBase = entryPointAbsResolveDir }
	}
	for _, t := range toParse { entryMetas[t.index].SourceIndex = parse(t.rr) }
	for i := range entryMetas {
		ep := &entryMetas[i]
		if s.fs.IsAbs(ep.OutputPath) {
			if !ep.OutputPathWasAutoGenerated {
				if rel, ok := s.fs.Rel(s.options.AbsOutputDir, ep.OutputPath); ok { ep.OutputPath = rel }
			} else {
				if rel, ok := s.fs.Rel(s.options.AbsOutputBase, ep.OutputPath); ok { ep.OutputPath = rel }
				if last := strings.LastIndexAny(ep.OutputPath, "/.\\"); last != -1 && ep.OutputPath[last] == '.' {
					ep.OutputPath = ep.OutputPath[:last]
				}
			}
		}
	}
	return entryMetas
}

type epRow struct {
	Name  string `json:"name"`
	OutputPath string `json:"outputPath"`
	SourceIndex uint32 `json:"sourceIndex"`
	Auto  bool   `json:"auto"`
}

func TestTmpGenEntryPoints116(t *testing.T) {
	type tc struct {
		name string
		files map[string]string
		entryPoints []EntryPoint
		stdin *config.StdinInfo
		absOutDir string
		absOutBase string
	}
	cases := []tc{
		{"relative", map[string]string{"/p/src/a.js": "var a = 1;", "/p/src/b.js": "var b = 2;"},
			[]EntryPoint{{InputPath: "./src/a.js"}, {InputPath: "./src/b.js"}}, nil, "/p/out", ""},
		{"explicit-output", map[string]string{"/p/src/a.js": "var a = 1;"},
			[]EntryPoint{{InputPath: "./src/a.js", OutputPath: "custom"}}, nil, "/p/out", ""},
		{"package-path", map[string]string{"/p/foo.js": "var f = 1;"},
			[]EntryPoint{{InputPath: "foo"}}, nil, "/p/out", ""},
		{"one-file", map[string]string{"/p/index.js": "var x=1;"},
			[]EntryPoint{{InputPath: "index.js"}}, nil, "/p/out", ""},
	}

	rows := []epRow{}
	for _, c := range cases {
		log := logger.NewDeferLog(logger.DeferLogNoVerboseOrDebug, nil)
		fsObj := fs.MockFS(c.files, fs.MockUnix, "/p")
		caches := cache.MakeCacheSet()
		opts := &config.Options{Mode: config.ModeBundle, AbsOutputDir: c.absOutDir, AbsOutputBase: c.absOutBase,
			ExtensionToLoader: map[string]config.Loader{".js": config.LoaderJS, ".css": config.LoaderCSS}}
		if c.stdin != nil { opts.Stdin = c.stdin }
		res := resolver.NewResolver(config.BuildCall, fsObj, log, caches, opts)
		s := &scanner{
			log: log, fs: fsObj, res: res, caches: caches, timer: &helpers.Timer{},
			visited: make(map[logger.Path]visitedFile), resultChannel: make(chan parseResult, 64),
			options: *opts, results: make([]parseResult, 32), uniqueKeyPrefix: "key",
		}
		// Pre-seed visited for each entry's resolved path so maybeParseFile dedups (no parseFile goroutine).
		// Resolve each entry via the real resolver to get its path, then assign a fixed sourceIndex.
		for i, ep := range c.entryPoints {
			absPath := ep.InputPath
			if !fsObj.IsAbs(absPath) { absPath = fsObj.Join("/p", absPath) }
			key := logger.Path{Text: absPath, Namespace: "file"}
			idx := uint32(i + 1)
			s.visited[key] = visitedFile{sourceIndex: idx}
			s.caches.SourceIndexCache.Get(key, cache.SourceIndexNormal) // keep cache in sync
		}
		metas := s.addEntryPoints(c.entryPoints)
		for s.remaining > 0 { <-s.resultChannel; s.remaining-- }

		// Build injected resolve results + parse callback mirroring the preseeded visited map.
		infos := make([][]resolver.ResolveResult, len(c.entryPoints))
		idxByPath := map[string]uint32{}
		for i, ep := range c.entryPoints {
			absPath := ep.InputPath
			if !fsObj.IsAbs(absPath) { absPath = fsObj.Join("/p", absPath) }
			idx := uint32(i + 1)
			idxByPath[absPath] = idx
			// package path "foo" failed to resolve in real run -> nil info
			if ep.InputPath == "foo" { continue }
			infos[i] = []resolver.ResolveResult{{PathPair: resolver.PathPair{Primary: logger.Path{Text: absPath, Namespace: "file"}}}}
		}
		parse := func(rr resolver.ResolveResult) uint32 { return idxByPath[rr.PathPair.Primary.Text] }
		// fresh scanner for helper (avoids AbsOutputBase mutation carry-over)
		s2 := &scanner{ fs: fsObj, options: *opts }
		helperMetas := addEntryPointsCore116(s2, c.entryPoints, infos, parse)
		// Cross-check: helper must equal the real function output
		if len(helperMetas) != len(metas) { t.Fatalf("%s: helper len %d != real %d", c.name, len(helperMetas), len(metas)) }
		for k := range metas {
			if helperMetas[k].OutputPath != metas[k].OutputPath || helperMetas[k].SourceIndex != metas[k].SourceIndex ||
				helperMetas[k].OutputPathWasAutoGenerated != metas[k].OutputPathWasAutoGenerated {
				t.Fatalf("%s: helper[%d]=%+v != real=%+v", c.name, k, helperMetas[k], metas[k])
			}
		}
		for _, m := range helperMetas {
			rows = append(rows, epRow{c.name, m.OutputPath, m.SourceIndex, m.OutputPathWasAutoGenerated})
		}
	}
	b, _ := json.MarshalIndent(rows, "", "  ")
	if err := os.WriteFile("/root/port/testdata/entrypoints-go.json", b, 0644); err != nil { t.Fatal(err) }
	for _, r := range rows { t.Logf("%-16s out=%q src=%d auto=%v", r.Name, r.OutputPath, r.SourceIndex, r.Auto) }
}

type drainRow struct {
	Name string `json:"name"`
	Slots []string `json:"slots"`
}

func TestTmpGenScanDrain116(t *testing.T) {
	rows := []drainRow{}
	cases := []struct{
		name string
		results []struct{ idx int; ok bool; mark string }
	}{
		{"drain-order", []struct{ idx int; ok bool; mark string }{{2,true,"C"},{0,true,"A"},{1,true,"B"}}},
		{"skip-notok", []struct{ idx int; ok bool; mark string }{{0,true,"A"},{1,false,"BAD"},{2,true,"C"}}},
	}
	for _, c := range cases {
		s := &scanner{
			fs: fs.MockFS(map[string]string{}, fs.MockUnix, "/"),
			options: config.Options{Mode: config.ModePassThrough},
			resultChannel: make(chan parseResult, 16),
			results: make([]parseResult, 4),
			remaining: len(c.results),
			caches: cache.MakeCacheSet(),
			visited: make(map[logger.Path]visitedFile),
			timer: &helpers.Timer{},
		}
		for _, r := range c.results {
			inp := graph.InputFile{Source: logger.Source{Contents: r.mark, KeyPath: logger.Path{Text: r.mark}}, Repr: &graph.JSRepr{}}
			inp.Source.Index = uint32(r.idx)
			s.resultChannel <- parseResult{ok: r.ok, file: scannerFile{inputFile: inp}}
		}
		s.scanAllDependencies()
		slots := []string{}
		for _, res := range s.results { slots = append(slots, string(res.file.inputFile.Source.Contents)) }
		rows = append(rows, drainRow{c.name, slots})
	}
	b, _ := json.MarshalIndent(rows, "", "  ")
	os.WriteFile("/root/port/testdata/scan-drain-go.json", b, 0644)
}

type psRow struct {
	Name string `json:"name"`
	Meta []string `json:"meta"`
	RelAfter []string `json:"relAfter"`
	MetafileFormat int `json:"mf"`
}

func TestTmpGenProcessScanned116(t *testing.T) {
	rows := []psRow{}
	mk := func(abs, rel string, attrs map[string]string) parseResult {
		kp := logger.Path{Text: "/p/" + rel, Namespace: "file"}
		if len(attrs) > 0 { kp.ImportAttributes = logger.EncodeImportAttributes(attrs) }
		pp := logger.PrettyPaths{Abs: abs, Rel: rel}
		src := logger.Source{KeyPath: kp, PrettyPaths: pp, Contents: "var x=1;"}
		inp := graph.InputFile{Source: src, Repr: &graph.JSRepr{}}
		inp.Repr.(*graph.JSRepr).AST.ImportRecords = []ast.ImportRecord{}
		return parseResult{ok: true, file: scannerFile{inputFile: inp}}
	}
	cases := []struct{
		name string
		needsMeta bool
		minified bool
		results []parseResult
	}{
		{"nometa", false, false, []parseResult{mk("/p/a.js","a.js",nil)}},
		{"meta-noimports", true, false, []parseResult{mk("/p/a.js","a.js",nil)}},
		{"collision", true, false, []parseResult{
			mk("/p/m.js","m.js",map[string]string{"type":"json"}),
			mk("/p/m.js","m.js",map[string]string{"type":"text"}),
		}},
		{"big-minified", true, true, []parseResult{mk("/p/a.js","a.js",nil)}},
	}
	for _, c := range cases {
		mf := config.UnminifiedMetafile
		if c.minified { mf = config.MinifiedMetafile }
		s := &scanner{
			fs: fs.MockFS(map[string]string{}, fs.MockUnix, "/p"),
			options: config.Options{NeedsMetafile: c.needsMeta, MetafileFormat: mf},
			results: c.results,
			timer: &helpers.Timer{},
		}
		s.processScannedFiles(nil)
		meta := []string{}
		relAfter := []string{}
		for _, res := range s.results {
			if res.ok {
				meta = append(meta, res.file.jsonMetadataChunk)
				relAfter = append(relAfter, res.file.inputFile.Source.PrettyPaths.Rel)
			}
		}
		rows = append(rows, psRow{c.name, meta, relAfter, int(s.options.MetafileFormat)})
	}
	b, _ := json.MarshalIndent(rows, "", "  ")
	os.WriteFile("/root/port/testdata/process-scanned-go.json", b, 0644)
}
