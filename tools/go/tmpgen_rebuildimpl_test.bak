package api

// 第 106 轮 Go 探针：rebuildImpl 确定性早退路径（write=false + 空/缺失入口 → 错误，无文件写/无 timer）。
import ("encoding/json";"io";"os";"testing"
 "github.com/evanw/esbuild/internal/bundler"
 "github.com/evanw/esbuild/internal/cache"
 "github.com/evanw/esbuild/internal/config"
 "github.com/evanw/esbuild/internal/logger"
)

type riMsg struct { Text string `json:"text"`; ID string `json:"id"`; Kind int `json:"kind"` }
type riFile struct { Path string `json:"path"`; Contents string `json:"contents"`; Hash string `json:"hash"` }
type riRow struct { Name string `json:"name"`; ErrCount int `json:"errCount"`; ErrTexts []string `json:"errTexts"`; Files []riFile `json:"files"`; HashCount int `json:"hashCount"`; Stderr string `json:"stderr"`; WarnRepeated int `json:"warnRepeated"` }

func TestTmpGenRebuildImpl106(t *testing.T){
  rows:=[]riRow{}
  run:=func(name string, entries []EntryPointForTest, warnings []logger.Msg, mangle map[string]interface{}) riRow {
    old:=os.Stderr; r,w,_:=os.Pipe(); os.Stderr=w
    ep:=make([]bundler.EntryPoint,0,len(entries))
    for _,e:=range entries { ep=append(ep,bundler.EntryPoint{InputPath:e.Path}) }
    args:=rebuildArgs{
      caches:cache.MakeCacheSet(),
      logOptions:logger.OutputOptions{IncludeSource:true,Color:logger.ColorNever},
      logWarnings:warnings,
      entryPoints:ep,
      options:config.Options{},
      mangleCache: mangle,
      absWorkingDir:"/tmp",
      write:false,
    }
    st,hashes:=rebuildImpl(args,nil)
    w.Close(); os.Stderr=old; eb,_:=io.ReadAll(r)
    row:=riRow{Name:name,ErrCount:len(st.result.Errors),ErrTexts:[]string{},Files:[]riFile{},HashCount:len(hashes),Stderr:string(eb),WarnRepeated:0}
    for _,e:=range st.result.Errors{row.ErrTexts=append(row.ErrTexts,e.Text)}
    for _,f:=range st.result.OutputFiles{row.Files=append(row.Files,riFile{f.Path,string(f.Contents),f.Hash})}
    for _,m:=range warnings{_ = m}
    return row
  }
  rows=append(rows,run("empty-entrypoints",nil,nil,nil))
  warning:=logger.Msg{Kind:logger.Warning,Data:logger.MsgData{Text:"repeat-warn"}}
  rows=append(rows,run("with-warning",nil,[]logger.Msg{warning},nil))
  rows=append(rows,run("mangle-bad-value",nil,nil,map[string]interface{}{"foo":true}))
  rows=append(rows,run("mangle-valid",nil,nil,map[string]interface{}{"foo":"a","bar":false}))
  b,err:=json.MarshalIndent(rows,"","  ");if err!=nil{t.Fatal(err)}
  if err:=os.WriteFile("/root/port/testdata/rebuild-impl-go.json",b,0644);err!=nil{t.Fatal(err)}
  t.Logf("wrote %d rows bytes=%d",len(rows),len(b))
}
type EntryPointForTest struct{ Path string }
