package js_parser_test

import (
	"encoding/base64"
	"encoding/json"
	"os"
	"testing"

	"github.com/evanw/esbuild/internal/ast"
	"github.com/evanw/esbuild/internal/config"
	"github.com/evanw/esbuild/internal/js_parser"
	"github.com/evanw/esbuild/internal/js_printer"
	"github.com/evanw/esbuild/internal/logger"
	"github.com/evanw/esbuild/internal/renamer"
)

type mrRow struct { Name string `json:"name"`; Out string `json:"out"` }

func mrPrint(src string) string {
	log := logger.NewDeferLog(logger.DeferLogNoVerboseOrDebug, nil)
	source := logger.Source{Index: 0, KeyPath: logger.Path{Text: "<stdin>"}, Contents: src}
	po := &config.Options{OutputFormat: config.FormatESModule}
	po.MinifySyntax = true
	tree, ok := js_parser.Parse(log, source, js_parser.OptionsFromConfig(po))
	if !ok { return "PARSE_FAIL" }
	symbols := ast.NewSymbolMap(1)
	symbols.SymbolsForSource[0] = tree.Symbols
	r := renamer.NewNoOpRenamer(symbols)
	opts := js_printer.Options{OutputFormat: config.FormatESModule, MinifySyntax: true}
	return string(js_printer.Print(tree, symbols, r, opts).JS)
}

func TestTmpGenMaybeRewrite113(t *testing.T) {
	cases := []struct{ name, src string }{
		{"obj-prop", "var x = ({a: 1, b: 2}).a;\n"},
		{"obj-prop-miss", "var x = ({a: 1}).z;\n"},
		{"obj-method", "var x = ({a() {}}).a;\n"},
	}
	rows := []mrRow{}
	for _, c := range cases {
		out := mrPrint(c.src)
		rows = append(rows, mrRow{Name: c.name, Out: base64.StdEncoding.EncodeToString([]byte(out))})
		t.Logf("%-16s => %q", c.name, out)
	}
	b, _ := json.MarshalIndent(rows, "", "  ")
	os.WriteFile("/root/port/testdata/maybe-rewrite-go.json", b, 0644)
}
