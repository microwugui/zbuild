package resolver

// Batch 65 Go probe: resolver pure string helpers (2 functions, one oracle).
import (
	"encoding/json"
	"os"
	"strconv"
	"testing"
)

func TestTmpGenResolverPure(t *testing.T) {
	type row struct { Fn string `json:"fn"`; Arg string `json:"arg"`; Out string `json:"out"` }
	var out []row

	// globstarToEscapedRegexp
	for _, s := range []string{"foo", "*.js", "a?b", "**/*.js", "a/**/b", "src/**", "a.b+c", "**", "[abc]{x,y}", "a\\b", "x/*/y"} {
		v, ok := globstarToEscapedRegexp(s)
		out = append(out, row{"globstarToEscapedRegexp", s, v + "|" + strconv.FormatBool(ok)})
	}

	// esmParsePackageName
	for _, s := range []string{"react", "react-dom/client", "@scope/pkg", "@scope/pkg/sub", "@scope", "", "./local", "a\\b", "pkg%name", "@scope/pkg"} {
		name, sub, ok := esmParsePackageName(s)
		out = append(out, row{"esmParsePackageName", s, name + "|" + sub + "|" + strconv.FormatBool(ok)})
	}

	b, err := json.MarshalIndent(out, "", "  ")
	if err != nil { t.Fatal(err) }
	if err := os.WriteFile("/root/port/testdata/resolver-pure-go.json", b, 0644); err != nil { t.Fatal(err) }
	t.Logf("wrote %d rows", len(out))
}
