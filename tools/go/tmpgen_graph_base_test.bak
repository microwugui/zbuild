package graph

// 第 143 批 Go 探针：LinkerGraph 底座（symbol/全局分配 + part→symbol + chunk 图）。
// 这是解开 Link() 依赖闭包的第一片：CloneLinkerGraph + 5 mutator + 3 accessor。
import (
	"encoding/json"
	"fmt"
	"os"
	"testing"

	"github.com/evanw/esbuild/internal/ast"
	"github.com/evanw/esbuild/internal/js_ast"
	"github.com/evanw/esbuild/internal/css_ast"
	"github.com/evanw/esbuild/internal/logger"
	"github.com/evanw/esbuild/internal/runtime"
)

func gbRef(s, i uint32) ast.Ref { return ast.Ref{SourceIndex: s, InnerIndex: i} }

// makeInput builds an InputFile with a JSRepr carrying the given symbols/exports/parts.
func makeInput(srcIdx uint32, symNames []string, exportNames []string, partCount int, src string, importCount int) InputFile {
	syms := make([]ast.Symbol, len(symNames))
	for i, n := range symNames {
		syms[i] = ast.Symbol{OriginalName: n, Link: ast.InvalidRef}
	}
	namedExports := make(map[string]js_ast.NamedExport)
	topSymToParts := make(map[ast.Ref][]uint32)
	for _, n := range exportNames {
		namedExports[n] = js_ast.NamedExport{Ref: gbRef(srcIdx, 0)}
		topSymToParts[gbRef(srcIdx, 0)] = []uint32{0}
	}
	parts := make([]js_ast.Part, partCount)
	for i := range parts {
		parts[i] = js_ast.Part{SymbolUses: map[ast.Ref]js_ast.SymbolUse{}}
	}
	records := make([]ast.ImportRecord, importCount)
	for i := range records { records[i] = ast.ImportRecord{Kind: ast.ImportStmt} }
	scope := &js_ast.Scope{}
	return InputFile{
		Source: logger.Source{Contents: src, KeyPath: logger.Path{Text: fmt.Sprintf("/src/%d.js", srcIdx)}},
		Repr: &JSRepr{
			AST: js_ast.AST{
				Symbols: syms, Parts: parts, ImportRecords: records,
				NamedExports: namedExports, ModuleScope: scope,
				TopLevelSymbolToPartsFromParser: topSymToParts,
				ExportsRef: gbRef(srcIdx, 0), ModuleRef: gbRef(srcIdx, 0),
			},
			Meta: JSReprMeta{},
		},
	}
}

type gbRow struct { Fn string `json:"fn"`; Arg map[string]interface{} `json:"arg"`; Out interface{} `json:"out"` }

func dumpRef(r ast.Ref) interface{} { return []interface{}{r.SourceIndex, r.InnerIndex} }

func dumpGraph(g *LinkerGraph) map[string]interface{} {
	files := []interface{}{}
	for i := range g.Files {
		f := &g.Files[i]
		bits := []int{}
		for b := uint(0); b < uint(len(g.EntryPoints()))+2; b++ { if b/8 < uint(len(f.EntryBits.String())) && f.EntryBits.HasBit(b) { bits = append(bits, int(b)) } }
		files = append(files, map[string]interface{}{
			"kind": int(f.entryPointKind), "dist": f.DistanceFromEntryPoint,
			"epChunk": f.EntryPointChunkIndex, "isLive": f.IsLive, "bits": bits,
		})
	}
	eps := []interface{}{}
	for _, ep := range g.EntryPoints() { eps = append(eps, []interface{}{ep.OutputPath, ep.SourceIndex, ep.OutputPathWasAutoGenerated}) }
	symCounts := []interface{}{}
	for _, s := range g.Symbols.SymbolsForSource { symCounts = append(symCounts, len(s)) }
	return map[string]interface{}{
		"files": files, "entryPoints": eps, "symCounts": symCounts,
		"reachable": g.ReachableFiles, "stable": g.StableSourceIndices,
	}
}

func dumpRepr(g *LinkerGraph, sourceIndex uint32) map[string]interface{} {
	repr := g.Files[sourceIndex].InputFile.Repr.(*JSRepr)
	parts := []interface{}{}
	for _, p := range repr.AST.Parts {
		uses := []interface{}{}
		for _, u := range p.SymbolUses { uses = append(uses, u.CountEstimate) }
		deps := []interface{}{}
		for _, d := range p.Dependencies { deps = append(deps, []interface{}{d.SourceIndex, d.PartIndex}) }
		parts = append(parts, map[string]interface{}{"uses": uses, "deps": deps, "decl": len(p.DeclaredSymbols)})
	}
	generated := []interface{}{}
	for _, r := range repr.AST.ModuleScope.Generated { generated = append(generated, dumpRef(r)) }
	importsToBind := []interface{}{}
	for _, d := range repr.Meta.ImportsToBind { importsToBind = append(importsToBind, []interface{}{d.SourceIndex, dumpRef(d.Ref)}) }
	overlay := []interface{}{}
	for _, v := range repr.Meta.TopLevelSymbolToPartsOverlay { overlay = append(overlay, v) }
	return map[string]interface{}{
		"parts": parts, "generated": generated, "importsToBind": importsToBind,
		"overlay": overlay, "nImportRecords": len(repr.AST.ImportRecords),
		"resolvedExports": len(repr.Meta.ResolvedExports),
	}
}

func TestTmpGenGraphBase(t *testing.T) {
	var out []gbRow
	add := func(fn string, arg map[string]interface{}, o interface{}) { out = append(out, gbRow{fn, arg, o}) }

	// base inputs: 3 files + runtime file at SourceIndex=0
	runtimeFile := makeInput(runtime.SourceIndex, []string{"__commonJS", "__esm", "__commonJSMin", "__esmMin"}, nil, 1, "runtime", 0)
	a := makeInput(1, []string{"a", "b"}, []string{"foo", "bar"}, 2, "a source", 1)
	fileB := makeInput(2, []string{"c"}, []string{"baz"}, 1, "b source", 0)
	inputs := []InputFile{runtimeFile, a, fileB}
	reachable := []uint32{0, 1, 2}
	entryPoints := []EntryPoint{{OutputPath: "a.js", SourceIndex: 1, OutputPathWasAutoGenerated: true}}

	for _, codeSplit := range []bool{false, true} {
		g := CloneLinkerGraph(inputs, reachable, entryPoints, codeSplit)
		add("CloneLinkerGraph", map[string]interface{}{"codeSplit": codeSplit}, dumpGraph(&g))
		add("CloneLinkerGraph.repr1", map[string]interface{}{"codeSplit": codeSplit}, dumpRepr(&g, 1))
	}

	// Anti-alias: CloneLinkerGraph must not mutate the original (immutable) input AST/Meta
	{
		origBefore := len(inputs[1].Repr.(*JSRepr).AST.Symbols)
		g2 := CloneLinkerGraph(inputs, reachable, entryPoints, false)
		g2.GenerateNewSymbol(1, ast.SymbolUnbound, "x")
		g2.Files[1].InputFile.Repr.(*JSRepr).Meta.ResolvedExports["NEW"] = ExportData{}
		origAfter := len(inputs[1].Repr.(*JSRepr).AST.Symbols)
		origMeta := len(inputs[1].Repr.(*JSRepr).Meta.ResolvedExports)
		add("CloneLinkerGraph.antiAlias", map[string]interface{}{}, []interface{}{origBefore == origAfter, origMeta})
	}

	// mutators on a fresh graph
	g := CloneLinkerGraph(inputs, reachable, entryPoints, false)

	// GenerateNewSymbol
	r := g.GenerateNewSymbol(1, ast.SymbolUnbound, "generated")
	add("GenerateNewSymbol", map[string]interface{}{"src": 1, "kind": int(ast.SymbolUnbound), "name": "generated"},
		map[string]interface{}{"ref": dumpRef(r), "repr": dumpRepr(&g, 1), "symCount": len(g.Symbols.SymbolsForSource[1])})

	// AddPartToFile: a part with a top-level declared symbol
	part := js_ast.Part{
		DeclaredSymbols: []js_ast.DeclaredSymbol{{Ref: gbRef(1, 0), IsTopLevel: true}},
		SymbolUses:      map[ast.Ref]js_ast.SymbolUse{gbRef(1, 1): {CountEstimate: 2}},
	}
	pi := g.AddPartToFile(1, part)
	add("AddPartToFile", map[string]interface{}{"src": 1, "declTop": true, "uses": 2},
		map[string]interface{}{"partIndex": pi, "repr": dumpRepr(&g, 1)})

	// GenerateSymbolImportAndUse
	g2 := CloneLinkerGraph(inputs, reachable, entryPoints, false)
	part2 := js_ast.Part{
		DeclaredSymbols: []js_ast.DeclaredSymbol{{Ref: gbRef(1, 0), IsTopLevel: true}},
		SymbolUses:      map[ast.Ref]js_ast.SymbolUse{},
	}
	pi2 := g2.AddPartToFile(1, part2)
	g2.GenerateSymbolImportAndUse(1, pi2, gbRef(2, 0), 3, 2)
	add("GenerateSymbolImportAndUse", map[string]interface{}{"useCount": 3, "cross": true}, dumpRepr(&g2, 1))

	// GenerateSymbolImportAndUse useCount=0 (no-op)
	g3 := CloneLinkerGraph(inputs, reachable, entryPoints, false)
	part3 := js_ast.Part{SymbolUses: map[ast.Ref]js_ast.SymbolUse{}}
	pi3 := g3.AddPartToFile(1, part3)
	g3.GenerateSymbolImportAndUse(1, pi3, gbRef(2, 0), 0, 2)
	add("GenerateSymbolImportAndUse.zero", map[string]interface{}{"useCount": 0}, dumpRepr(&g3, 1))

	// GenerateRuntimeSymbolImportAndUse
	g4 := CloneLinkerGraph(inputs, reachable, entryPoints, false)
	part4 := js_ast.Part{SymbolUses: map[ast.Ref]js_ast.SymbolUse{}}
	pi4 := g4.AddPartToFile(1, part4)
	g4.GenerateRuntimeSymbolImportAndUse(1, pi4, "__esm", 5)
	add("GenerateRuntimeSymbolImportAndUse", map[string]interface{}{"name": "__esm", "useCount": 5}, dumpRepr(&g4, 1))

	// JSRepr.TopLevelSymbolToParts: overlay vs parser fallback
	jp := inputs[1].Repr.(*JSRepr)
	jl := jp.TopLevelSymbolToParts(gbRef(1, 0))
	add("TopLevelSymbolToParts.parser", map[string]interface{}{"src": 1}, jl)

	// LineColumnTracker (lazy) + ImportRecords accessors
	{
		f := &g.Files[1]
		tracker := f.LineColumnTracker()
		// dump a stable property: tracker on same source, line 0 column 0
		r := tracker.MsgData(logger.Range{Loc: logger.Loc{Start: 0}, Len: 1}, "x")
		add("LineColumnTracker", map[string]interface{}{"src": 1}, []interface{}{r.Location.Line, r.Location.Column, f.LineColumnTracker() == tracker})
	}
	{
		jsr := &JSRepr{AST: js_ast.AST{ImportRecords: []ast.ImportRecord{{Kind: ast.ImportStmt}, {Kind: ast.ImportDynamic}}}}
		csr := &CSSRepr{AST: css_ast.AST{ImportRecords: []ast.ImportRecord{{Kind: ast.ImportAt}}}}
		cor := &CopyRepr{}
		add("JSRepr.ImportRecords", map[string]interface{}{}, len(*jsr.ImportRecords()))
		add("CSSRepr.ImportRecords", map[string]interface{}{}, len(*csr.ImportRecords()))
		add("CopyRepr.ImportRecords", map[string]interface{}{}, cor.ImportRecords() == nil)
	}

	b, err := json.MarshalIndent(out, "", "  ")
	if err != nil { t.Fatal(err) }
	if err := os.WriteFile("/root/port/testdata/graph-base-go.json", b, 0644); err != nil { t.Fatal(err) }
	t.Logf("wrote %d rows", len(out))
}
