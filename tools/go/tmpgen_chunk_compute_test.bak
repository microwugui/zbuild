package linker

// 第 147 批 Go 探针：chunk 计算底座（chunkInfo / computeChunks / findImportedPartsInJSOrder
// / findImportedFilesInCSSOrder / PathRelativeToOutbase），一次构造图 + treeShaking + computeChunks，
// dump c.chunks 为规范化 IR，供 TS 侧逐字节比对。
import (
  "encoding/json"
  "os"
  "testing"

  "github.com/evanw/esbuild/internal/ast"
  "github.com/evanw/esbuild/internal/config"
  "github.com/evanw/esbuild/internal/css_ast"
  "github.com/evanw/esbuild/internal/css_lexer"
  "github.com/evanw/esbuild/internal/fs"
  "github.com/evanw/esbuild/internal/graph"
  "github.com/evanw/esbuild/internal/js_ast"
  "github.com/evanw/esbuild/internal/logger"
)

func ccRef(s, i uint32) ast.Ref { return ast.Ref{SourceIndex: s, InnerIndex: i} }

type ccImport struct {
  source int
  path string
  kind ast.ImportKind
  conditions string // layer name for the @import condition, "" = none
}
type ccCSSRule struct {
  recIdx uint32
  conditions string
}
type ccPart struct {
  deps [][2]uint32
  removable bool
  forceTree bool
  importRecs []uint32
}
type ccFile struct {
  kind string
  path string
  parts []ccPart
  imports []ccImport
  cssSource int
  sideEffects graph.SideEffectsKind
  layersPre [][]string
  layersPost [][]string
  cssRules []ccCSSRule
}
type ccEntry struct { source int; out string; auto bool }

func ccCond(layer string) *css_ast.ImportConditions {
  if layer == "" { return nil }
  return &css_ast.ImportConditions{
    Layers: []css_ast.Token{{Kind: css_lexer.TIdent, Text: layer}},
  }
}

func ccBuild(specs []ccFile, entries []ccEntry, codeSplit bool) (*linkerContext, fs.FS) {
  inputs := make([]graph.InputFile, len(specs))
  for si, sp := range specs {
    records := make([]ast.ImportRecord, len(sp.imports))
    for j, im := range sp.imports {
      r := ast.ImportRecord{Kind: im.kind, Path: logger.Path{Text: im.path, Namespace: "file"}}
      if im.source >= 0 { r.SourceIndex = ast.MakeIndex32(uint32(im.source)) }
      records[j] = r
    }
    var repr graph.InputFileRepr
    if sp.kind == "css" {
      rules := make([]css_ast.Rule, 0)
      for _, cr := range sp.cssRules {
        rules = append(rules, css_ast.Rule{Data: &css_ast.RAtImport{ImportRecordIndex: cr.recIdx, ImportConditions: ccCond(cr.conditions)}})
      }
      repr = &graph.CSSRepr{AST: css_ast.AST{
        ImportRecords: records, Rules: rules,
        LayersPreImport: sp.layersPre, LayersPostImport: sp.layersPost,
      }}
    } else {
      parts := make([]js_ast.Part, len(sp.parts))
      for pi, ps := range sp.parts {
        p := js_ast.Part{CanBeRemovedIfUnused: ps.removable, ForceTreeShaking: ps.forceTree,
          SymbolUses: map[ast.Ref]js_ast.SymbolUse{}, ImportRecordIndices: ps.importRecs}
        for _, d := range ps.deps { p.Dependencies = append(p.Dependencies, js_ast.Dependency{SourceIndex: d[0], PartIndex: d[1]}) }
        parts[pi] = p
      }
      jr := &graph.JSRepr{AST: js_ast.AST{
        Parts: parts, ImportRecords: records, ModuleScope: &js_ast.Scope{},
        ExportsRef: ccRef(uint32(si), 0),
      }}
      if sp.cssSource >= 0 { jr.CSSSourceIndex = ast.MakeIndex32(uint32(sp.cssSource)) }
      repr = jr
    }
    inp := graph.InputFile{
      Source: logger.Source{Contents: "", KeyPath: logger.Path{Text: sp.path, Namespace: "file"}},
      Repr: repr,
    }
    inp.SideEffects.Kind = sp.sideEffects
    inputs[si] = inp
  }
  eps := make([]graph.EntryPoint, len(entries))
  for i, e := range entries {
    eps[i] = graph.EntryPoint{SourceIndex: uint32(e.source), OutputPath: e.out, OutputPathWasAutoGenerated: e.auto}
  }
  reachable := make([]uint32, len(specs))
  for i := range reachable { reachable[i] = uint32(i) }
  g := graph.CloneLinkerGraph(inputs, reachable, eps, codeSplit)
  fsys := fs.MockFS(map[string]string{}, fs.MockUnix, "/")
  opts := &config.Options{
    CodeSplitting: codeSplit, TreeShaking: true,
    OutputExtensionJS: ".js", OutputExtensionCSS: ".css",
    AbsOutputBase: "/project/src",
    EntryPathTemplate: []config.PathTemplate{
      {Data: "./", Placeholder: config.DirPlaceholder},
      {Data: "/", Placeholder: config.NamePlaceholder},
    },
    ChunkPathTemplate: []config.PathTemplate{
      {Data: "./", Placeholder: config.NamePlaceholder},
      {Data: "-", Placeholder: config.HashPlaceholder},
    },
  }
  c := &linkerContext{graph: g, options: opts, fs: fsys, uniqueKeyPrefix: "TEST"}
  c.treeShakingAndCodeSplitting()
  c.computeChunks()
  return c, fsys
}

type ccTPL struct { Data string `json:"data"`; Placeholder int `json:"ph"` }
type ccPartRange struct { S uint32 `json:"s"`; B uint32 `json:"b"`; E uint32 `json:"e"` }
type ccCondDump struct { Layers []string `json:"layers"`; Supports []string `json:"supports"`; Queries int `json:"queries"` }
type ccImportOrder struct {
  Kind int `json:"kind"`
  SourceIndex uint32 `json:"sourceIndex"`
  ExternalPath string `json:"externalPath"`
  Layers [][]string `json:"layers"`
  Conditions []ccCondDump `json:"conditions"`
  CondRecCount int `json:"condRecCount"`
}
type ccChunkDump struct {
  UniqueKey string `json:"key"`
  EntryBits []int `json:"bits"`
  IsEntry bool `json:"isEntry"`
  SourceIndex uint32 `json:"sourceIndex"`
  EntryBit uint `json:"entryBit"`
  Files []uint32 `json:"files"`
  Repr string `json:"repr"`
  FilesInOrder []uint32 `json:"filesInOrder"`
  PartsInOrder []ccPartRange `json:"partsInOrder"`
  ImportsInOrder []ccImportOrder `json:"importsInOrder"`
  HasCSSChunk bool `json:"hasCSS"`
  CSSChunkIndex uint32 `json:"cssChunkIndex"`
  FinalTemplate []ccTPL `json:"tpl"`
  EntryPointChunkIndex uint32 `json:"epChunk"`
}

func ccCondDumpOf(cs []css_ast.ImportConditions) []ccCondDump {
  out := []ccCondDump{}
  for _, c := range cs {
    layers := []string{}
    for _, t := range c.Layers { layers = append(layers, t.Text) }
    supp := []string{}
    for _, t := range c.Supports { supp = append(supp, t.Text) }
    out = append(out, ccCondDump{Layers: layers, Supports: supp, Queries: len(c.Queries)})
  }
  return out
}

func ccDump(c *linkerContext) []ccChunkDump {
  out := []ccChunkDump{}
  nbits := uint(len(c.graph.EntryPoints()))
  _ = nbits
  for _, ch := range c.chunks {
    d := ccChunkDump{
      UniqueKey: ch.uniqueKey, IsEntry: ch.isEntryPoint, SourceIndex: ch.sourceIndex,
      EntryBit: ch.entryPointBit, Repr: "js",
      Files: []uint32{}, FilesInOrder: []uint32{}, PartsInOrder: []ccPartRange{},
      ImportsInOrder: []ccImportOrder{}, FinalTemplate: []ccTPL{}, EntryBits: []int{},
    }
    for b := uint(0); b < nbits; b++ { if ch.entryBits.HasBit(b) { d.EntryBits = append(d.EntryBits, int(b)) } }
    for si := range ch.filesWithPartsInChunk { d.Files = append(d.Files, si) }
    sortU32(d.Files)
    switch r := ch.chunkRepr.(type) {
    case *chunkReprJS:
      d.Repr = "js"; d.FilesInOrder = r.filesInChunkInOrder
      for _, pr := range r.partsInChunkInOrder { d.PartsInOrder = append(d.PartsInOrder, ccPartRange{pr.sourceIndex, pr.partIndexBegin, pr.partIndexEnd}) }
      d.HasCSSChunk = r.hasCSSChunk; d.CSSChunkIndex = r.cssChunkIndex
    case *chunkReprCSS:
      d.Repr = "css"
      for _, io := range r.importsInChunkInOrder {
        layers := io.layers; if layers == nil { layers = [][]string{} }
      x := ccImportOrder{Kind: int(io.kind), Layers: layers,
          Conditions: ccCondDumpOf(io.conditions), CondRecCount: len(io.conditionImportRecords)}
        if io.kind == cssImportSourceIndex { x.SourceIndex = io.sourceIndex }
        if io.kind == cssImportExternalPath { x.ExternalPath = io.externalPath.Text }
        d.ImportsInOrder = append(d.ImportsInOrder, x)
      }
    }
    for _, pt := range ch.finalTemplate {
      d.FinalTemplate = append(d.FinalTemplate, ccTPL{Data: pt.Data, Placeholder: int(pt.Placeholder)})
    }
    d.EntryPointChunkIndex = c.graph.Files[ch.sourceIndex].EntryPointChunkIndex
    out = append(out, d)
  }
  return out
}

func sortU32(a []uint32) { for i:=1;i<len(a);i++ { for j:=i;j>0&&a[j]<a[j-1];j-- { a[j],a[j-1]=a[j-1],a[j] } } }

type ccRow struct { Fn string `json:"fn"`; Arg map[string]interface{} `json:"arg"`; Out interface{} `json:"out"` }

func TestTmpGenChunkCompute(t *testing.T) {
  var out []ccRow
  add := func(fn string, arg map[string]interface{}, o interface{}) { out = append(out, ccRow{fn, arg, o}) }

  // A: 2 JS entries share a dep, code splitting -> 3 chunks
  scenA := []ccFile{
    {kind:"js", cssSource:-1, path:"/project/src/a.js", parts:[]ccPart{{importRecs:[]uint32{0}}}, imports:[]ccImport{{source:2,kind:ast.ImportStmt}}, sideEffects:graph.HasSideEffects},
    {kind:"js", cssSource:-1, path:"/project/src/b.js", parts:[]ccPart{{importRecs:[]uint32{0}}}, imports:[]ccImport{{source:2,kind:ast.ImportStmt}}, sideEffects:graph.HasSideEffects},
    {kind:"js", cssSource:-1, path:"/project/src/shared/util.js", parts:[]ccPart{{}}, sideEffects:graph.HasSideEffects},
  }
  for _, split := range []bool{false, true} {
    c, _ := ccBuild(scenA, []ccEntry{{0,"a.js",false},{1,"b.js",false}}, split)
    add("computeChunks", map[string]interface{}{"scenario":"A","split":split}, ccDump(c))
  }

  // B: one JS entry importing a CSS file via a JS stub -> JS + CSS chunk
  scenB := []ccFile{
    {kind:"js", cssSource:-1, path:"/project/src/main.js", parts:[]ccPart{{importRecs:[]uint32{0}}}, imports:[]ccImport{{source:1,kind:ast.ImportStmt}}, sideEffects:graph.HasSideEffects},
    {kind:"js", path:"/project/src/stub.js", parts:[]ccPart{{}}, cssSource:2, sideEffects:graph.HasSideEffects},
    {kind:"css", path:"/project/src/style.css", cssRules:[]ccCSSRule{{recIdx:0}}, imports:[]ccImport{{source:-1,path:"ext.css",kind:ast.ImportStmt}}, layersPre:[][]string{{"base"}}, layersPost:[][]string{{"util"}}, sideEffects:graph.HasSideEffects},
  }
  {
    c, _ := ccBuild(scenB, []ccEntry{{0,"main.js",false}}, false)
    add("computeChunks", map[string]interface{}{"scenario":"B"}, ccDump(c))
  }

  // C: pure CSS entry with import chain + conditions + external + layers
  // NOTE: source index 0 is reserved (Go uses a 16-zero visited array, so index 0
  // is falsely "already visited"). Real esbuild never assigns 0 to a user file.
  scenC := []ccFile{
    {kind:"js", cssSource:-1, path:"/project/src/_unused.js", sideEffects:graph.NoSideEffects_EmptyAST},
    {kind:"css", path:"/project/src/e.css", cssRules:[]ccCSSRule{{recIdx:0,conditions:""},{recIdx:1,conditions:"layerA"},{recIdx:2,conditions:""}},
      imports:[]ccImport{{source:2,kind:ast.ImportStmt},{source:3,kind:ast.ImportStmt},{source:-1,path:"remote.css",kind:ast.ImportStmt}},
      layersPre:[][]string{{"first"}}, layersPost:[][]string{{"last"}}, sideEffects:graph.HasSideEffects},
    {kind:"css", path:"/project/src/one.css", cssRules:[]ccCSSRule{{recIdx:0}}, imports:[]ccImport{{source:3,kind:ast.ImportStmt}}, layersPost:[][]string{{"mid"}}, sideEffects:graph.HasSideEffects},
    {kind:"css", path:"/project/src/two.css", sideEffects:graph.HasSideEffects},
  }
  {
    c, _ := ccBuild(scenC, []ccEntry{{1,"e.css",false}}, false)
    add("computeChunks", map[string]interface{}{"scenario":"C"}, ccDump(c))
  }

  // D: dynamic-import entry -> non-user entry, PathRelativeToOutbase auto path
  scenD := []ccFile{
    {kind:"js", cssSource:-1, path:"/project/src/index.js", parts:[]ccPart{{importRecs:[]uint32{0}}}, imports:[]ccImport{{source:1,kind:ast.ImportDynamic}}, sideEffects:graph.HasSideEffects},
    {kind:"js", cssSource:-1, path:"/project/src/chunk.js", parts:[]ccPart{{}}, sideEffects:graph.HasSideEffects},
  }
  {
    c, _ := ccBuild(scenD, []ccEntry{{0,"index.js",false},{1,"",true}}, true)
    add("computeChunks", map[string]interface{}{"scenario":"D"}, ccDump(c))
  }

  b, err := json.MarshalIndent(out, "", "  ")
  if err != nil { t.Fatal(err) }
  if err := os.WriteFile("/root/port/testdata/chunk-compute-go.json", b, 0644); err != nil { t.Fatal(err) }
  t.Logf("wrote %d rows", len(out))
}
