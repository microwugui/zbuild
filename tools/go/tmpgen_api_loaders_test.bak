package api

// Batch 88 Go probe: validateLoaders helper.
import (
	"encoding/json"
	"os"
	"sort"
	"strconv"
	"testing"

	"github.com/evanw/esbuild/internal/logger"
)

func TestTmpGenApiLoaders(t *testing.T) {
	type row struct { Fn string `json:"fn"`; Arg string `json:"arg"`; Out string `json:"out"` }
	var out []row

	// validateLoaders: arg = JSON map of ext->loader (loader int)
	for _, s := range []string{
		`{".foo":0}`,
		`{".custom":4}`,
		`{"":2}`,
		`{".js":1,".ts":3}`,
	} {
		var vals map[string]Loader
		json.Unmarshal([]byte(s), &vals)
		log := logger.NewDeferLog(logger.DeferLogNoVerboseOrDebug, nil)
		result := validateLoaders(log, vals)
		keys := make([]string, 0, len(result))
		for k := range result { keys = append(keys, k) }
		sort.Strings(keys)
		dump := ""
		for _, k := range keys { dump += k + "=" + strconv.Itoa(int(result[k])) + ";" }
		out = append(out, row{"validateLoaders", s, dump})
	}

	b, err := json.MarshalIndent(out, "", "  ")
	if err != nil { t.Fatal(err) }
	if err := os.WriteFile("/root/port/testdata/api-loaders-go.json", b, 0644); err != nil { t.Fatal(err) }
	t.Logf("wrote %d rows", len(out))
}
