package api

// 第 106 轮 Go 探针：printSummary（yarn/1 环境下去掉耗时的确定性路径）。
import ("encoding/json";"io";"os";"testing";"time"
 "github.com/evanw/esbuild/internal/logger"
)

type sumRow struct { Name string `json:"name"`; Stderr string `json:"stderr"`; WithFiles bool `json:"withFiles"` }

func TestTmpGenSummary106(t *testing.T){
  oldCwd,_:=os.Getwd(); defer os.Chdir(oldCwd)
  os.Chdir("/tmp")
  oldEnv,had:=os.LookupEnv("npm_config_user_agent"); defer func(){if had{os.Setenv("npm_config_user_agent",oldEnv)}else{os.Unsetenv("npm_config_user_agent")}}()
  os.Setenv("npm_config_user_agent","yarn/1.22.0 npm/?")
  rows:=[]sumRow{}
  run:=func(name string, files []OutputFile) sumRow {
    old:=os.Stderr; r,w,_:=os.Pipe(); os.Stderr=w
    printSummary(logger.ColorNever,files,time.Now())
    w.Close(); os.Stderr=old; eb,_:=io.ReadAll(r)
    return sumRow{Name:name,Stderr:string(eb),WithFiles:len(files)>0}
  }
  rows=append(rows,run("empty",nil))
  rows=append(rows,run("one-file",[]OutputFile{{Path:"/tmp/out.js",Contents:[]byte("var x = 1;")}}))
  rows=append(rows,run("two-files",[]OutputFile{{Path:"/tmp/out.js",Contents:[]byte("var x = 1;")},{Path:"/tmp/out.js.map",Contents:[]byte("{}")}}))
  b,err:=json.MarshalIndent(rows,"","  ");if err!=nil{t.Fatal(err)}
  if err:=os.WriteFile("/root/port/testdata/print-summary-go.json",b,0644);err!=nil{t.Fatal(err)}
  t.Logf("wrote %d rows bytes=%d",len(rows),len(b))
}
