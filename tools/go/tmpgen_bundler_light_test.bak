package bundler

import (
	"encoding/json"
	"os"
	"testing"

	"github.com/evanw/esbuild/internal/fs"
	"github.com/evanw/esbuild/internal/graph"
	"github.com/evanw/esbuild/internal/logger"
)

type blRow struct { Name string `json:"name"`; Out string `json:"out"` }
type blFixture struct { Rows []blRow `json:"rows"` }

func TestTmpGenBundlerLight(t *testing.T) {
	fx := blFixture{}
	f := fs.MockFS(map[string]string{}, 0, "/home/user/project")

	// lowestCommonAncestorDirectory
	lcaCases := []struct{ name string; paths []string; auto []bool }{
		{"empty", nil, nil},
		{"explicit-only", []string{"/a/b/c.js"}, []bool{false}},
		{"one-auto", []string{"/a/b/c.js"}, []bool{true}},
		{"two-auto", []string{"/a/b/c.js", "/a/b/d.js"}, []bool{true, true}},
		{"divergent", []string{"/a/b/c.js", "/x/y/z.js"}, []bool{true, true}},
		{"prefix", []string{"/a/b/c.js", "/a/bb/d.js"}, []bool{true, true}},
		{"mixed", []string{"/a/b/c.js", "/a/d/e.js"}, []bool{true, false}},
	}
	for _, c := range lcaCases {
		eps := []graph.EntryPoint{}
		for i, p := range c.paths {
			eps = append(eps, graph.EntryPoint{OutputPath: p, OutputPathWasAutoGenerated: c.auto[i]})
		}
		fx.Rows = append(fx.Rows, blRow{"lca:" + c.name, lowestCommonAncestorDirectory(f, eps)})
	}

	// sanitizeLocation
	sanCases := []struct{ name, ns, abs, rel string }{
		{"nil-loc", "", "", ""},
		{"empty-ns", "", "/a/b.js", ""},
		{"with-ns", "file", "/a/b.js", ""},
		{"empty-path", "", "", ""},
	}
	for _, c := range sanCases {
		if c.name == "nil-loc" {
			sanitizeLocation(f, nil)
			fx.Rows = append(fx.Rows, blRow{"san:" + c.name, "nil"})
			continue
		}
		loc := &logger.MsgLocation{Namespace: c.ns, File: logger.PrettyPaths{Abs: c.abs, Rel: c.rel}}
		sanitizeLocation(f, loc)
		out, _ := json.Marshal(map[string]string{"ns": loc.Namespace, "abs": loc.File.Abs, "rel": loc.File.Rel})
		fx.Rows = append(fx.Rows, blRow{"san:" + c.name, string(out)})
	}

	bts, _ := json.MarshalIndent(fx, "", "  ")
	if err := os.WriteFile("/root/port/testdata/bundler-light-go.json", bts, 0644); err != nil { t.Fatal(err) }
	t.Logf("wrote %d rows bytes=%d", len(fx.Rows), len(bts))
}
